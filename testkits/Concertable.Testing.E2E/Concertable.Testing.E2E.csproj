<Project Sdk="Microsoft.NET.Sdk">

  <Sdk Name="Aspire.AppHost.Sdk" Version="13.3.2" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>false</IsTestProject>
    <IsPackable>true</IsPackable>
    <Description>Service-agnostic end-to-end testing harness: Aspire orchestration helpers, polling, health waiting, Respawn database reset, test token minting and Stripe customer resolution, shared by every Concertable service's E2E suite.</Description>
    <IsAspireHost>true</IsAspireHost>
    <CompositionValidationExclusion>E2E-only orchestration harness whose production project resources have dedicated composition coverage.</CompositionValidationExclusion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.SqlServer" />
    <PackageReference Include="Aspire.Hosting.Testing" />
    <PackageReference Include="Concertable.AppHost.Shared" />
    <PackageReference Include="Concertable.Auth.Hosting" />
    <PackageReference Include="Concertable.Payment.Hosting" />
    <PackageReference Include="Concertable.Seed.Identity" />
    <PackageReference Include="Concertable.Testing" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="Reqnroll" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Respawn" />
    <PackageReference Include="Stripe.net" />
    <PackageReference Include="xunit" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Concertable.Testing" />
  </ItemGroup>

</Project>
