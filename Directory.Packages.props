<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <ConcertableDotNetPlatformVersion>0.2.0-alpha.0.5</ConcertableDotNetPlatformVersion>
    <ConcertableAuthVersion>0.1.0-alpha.0.1384</ConcertableAuthVersion>
    <ConcertableB2BContractsVersion>0.1.0-alpha.0.1384</ConcertableB2BContractsVersion>
    <ConcertableCustomerVersion>0.1.0-alpha.0.1384</ConcertableCustomerVersion>
    <ConcertablePaymentVersion>0.1.0-alpha.0.1384</ConcertablePaymentVersion>
    <ConcertableSearchVersion>0.1.0-alpha.0.1384</ConcertableSearchVersion>
  </PropertyGroup>

  <!-- Nothing carves out of this repository, so versions live once at the root rather than per folder.
       An id follows the train of whichever repository publishes it: platform ids follow platform-dotnet,
       and each service's ids follow that service's own train. The trains advance independently, so
       asking for one train's version on another train's id fails NU1101 on a version that id never
       shipped. ReleaseTrainPinTests holds these equal to compatibility/local.yaml. -->
  <ItemGroup>
    <PackageVersion Include="Concertable.AppHost.Shared" Version="$(ConcertableDotNetPlatformVersion)" />
    <PackageVersion Include="Concertable.Frontend.Hosting" Version="$(ConcertableDotNetPlatformVersion)" />
    <PackageVersion Include="Concertable.Seed.Identity" Version="$(ConcertableDotNetPlatformVersion)" />
    <PackageVersion Include="Concertable.Testing" Version="$(ConcertableDotNetPlatformVersion)" />
    <PackageVersion Include="Concertable.Testing.Architecture" Version="$(ConcertableDotNetPlatformVersion)" />
    <PackageVersion Include="Concertable.Auth.Hosting" Version="$(ConcertableAuthVersion)" />
    <PackageVersion Include="Concertable.B2B.Hosting" Version="$(ConcertableB2BContractsVersion)" />
    <PackageVersion Include="Concertable.B2B.TestKit" Version="$(ConcertableB2BContractsVersion)" />
    <PackageVersion Include="Concertable.Customer.Hosting" Version="$(ConcertableCustomerVersion)" />
    <PackageVersion Include="Concertable.Customer.TestKit" Version="$(ConcertableCustomerVersion)" />
    <PackageVersion Include="Concertable.Payment.Hosting" Version="$(ConcertablePaymentVersion)" />
    <PackageVersion Include="Concertable.Payment.TestKit" Version="$(ConcertablePaymentVersion)" />
    <PackageVersion Include="Concertable.Search.Hosting" Version="$(ConcertableSearchVersion)" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="Appium.WebDriver" Version="5.2.0" />
    <PackageVersion Include="Aspire.Hosting.DevTunnels" Version="13.3.2" />
    <PackageVersion Include="Aspire.Hosting.NodeJs" Version="9.5.2" />
    <PackageVersion Include="Aspire.Hosting.SqlServer" Version="13.3.2" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.3.2" />
    <PackageVersion Include="coverlet.collector" Version="6.0.0" />
    <PackageVersion Include="Dapper" Version="2.1.72" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.3" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.8" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.59.0" />
    <PackageVersion Include="Reqnroll" Version="3.3.4" />
    <PackageVersion Include="Reqnroll.Microsoft.Extensions.DependencyInjection" Version="3.3.4" />
    <PackageVersion Include="Reqnroll.xUnit" Version="3.3.4" />
    <PackageVersion Include="Respawn" Version="7.0.0" />
    <PackageVersion Include="Stripe.net" Version="47.3.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.0.2" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <GlobalPackageReference Include="Meziantou.Analyzer" Version="3.0.98" />
    <GlobalPackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="3.3.4" />
  </ItemGroup>

  <ItemGroup>
    <GlobalPackageReference Include="MinVer" Version="7.0.0" />
  </ItemGroup>

</Project>
